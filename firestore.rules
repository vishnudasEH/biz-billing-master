rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only this Firebase Authentication account can access shop data.
    function owner() {
      return request.auth != null && request.auth.uid == 'sJ5zzvUCzVR5WqtJKxgs8mgAwpr1';
    }
    match /shopProfile/main { allow read, write: if owner(); }
    match /customers/{id} { allow read, write: if owner(); }
    match /jobs/{id} { allow read, write: if owner(); }
    match /invoices/{id} { allow read, write: if owner(); }
    match /payments/{id} { allow read, write: if owner(); }
    match /{document=**} { allow read, write: if false; }
  }
}
