rules_version = '2';

// Single-owner app: only the authenticated shop owner (any signed-in user,
// since this app is for one business/one login) can read or write data.
// If you ever add staff logins, tighten this further with a role field.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Single shop profile document
    match /shopProfile/{docId} {
      allow read, write: if isSignedIn();
    }

    // Customers
    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    // Jobs
    match /jobs/{jobId} {
      allow read, write: if isSignedIn();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // Payments
    match /payments/{paymentId} {
      allow read, write: if isSignedIn();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
